{
  "name": "dsh-lazy-tools",
  "version": "0.4.0",
  "description": "按需加载工具：核心工具保持原生可见，长尾工具收进一个 toolbox 入口，显著降低每次请求的上下文与 token 占用。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "tokens",
    "lazy",
    "toolbox",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test tests/",
    "check": "node --check lib/index.js && bun test tests/",
    "measure": "node scripts/measure-first-call.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chsw-CC/dsh-lazy-tools.git"
  },
  "homepage": "https://github.com/Chsw-CC/dsh-lazy-tools#readme",
  "bugs": {
    "url": "https://github.com/Chsw-CC/dsh-lazy-tools/issues"
  },
  "author": "Chsw-CC"
}
